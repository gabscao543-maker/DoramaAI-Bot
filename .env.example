# ─── Obrigatórios ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # Token do @BotFather
FISH_AUDIO_API_KEY=          # Chave da API Fish.audio (https://fish.audio)
PORT=8080

# ─── Recomendados ─────────────────────────────────────────
DID_API_KEY=                 # Chave da API D-ID (vídeos animados)
TELEGRAM_ADMIN_ID=           # Seu ID numérico no Telegram

# ─── Opcionais (fallback TTS) ────────────────────────────
ELEVENLABS_API_KEY=          # Chave ElevenLabs (TTS fallback)

# ─── Pagamento (opcional) ────────────────────────────────
OPENPIX_API_KEY=             # Chave OpenPix (PIX automático)
PIX_KEY=                     # Chave PIX manual
TONCOIN_ADDRESS=             # Endereço TON
VIP_PRICE_BRL=29.90          # Preço VIP em reais

# ─── Vozes Fish.audio (opcional — sobrescrever padrão) ───
# FISH_VOICE_PT_BR_F=        # reference_id voz feminina PT-BR
# FISH_VOICE_PT_BR_M=        # reference_id voz masculina PT-BR
# FISH_VOICE_EN=             # reference_id voz inglês
# FISH_VOICE_ES=             # reference_id voz espanhol
# FISH_VOICE_KO=             # reference_id voz coreano
# FISH_VOICE_JA=             # reference_id voz japonês
# FISH_VOICE_FR=             # reference_id voz francês
# FISH_VOICE_IT=             # reference_id voz italiano
# FISH_VOICE_DE=             # reference_id voz alemão
# FISH_VOICE_ZH=             # reference_id voz chinês
